PORT=3000

# Where the app connects. Under docker compose these are overridden to the
# service names; the host ports compose publishes are separate settings
# (REDIS_HOST_PORT / POSTGRES_HOST_PORT) so shifting one to dodge a local port
# conflict does not follow the app into the container.
REDIS_HOST=localhost
REDIS_PORT=6379

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# The frontend's origin. It runs from its own repository and compose file and
# calls this API from the browser, so a stale localhost value here blocks every
# request in production while the page itself still loads.
CORS_ORIGIN=http://localhost:5173

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

REPLICATE_API_TOKEN=

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=

# Tistory publishing
TISTORY_BLOG_NAME=
KAKAO_ID=
KAKAO_PASSWORD=

# Remote browser (browserless). Path must be the Playwright-protocol endpoint,
# not the CDP one, because the publish flow restores a saved session via
# newContext({ storageState }). Locally: ws://localhost:3000/chromium/playwright
# The ?token= value must match the browserless container's TOKEN; drop both to
# run the container without auth.
BROWSERLESS_URL=ws://browserless:3000/chromium/playwright?token=

# Debug only. "true" makes the publish flow launch a visible browser on this
# machine and ignore BROWSERLESS_URL, which then becomes optional. Needs the
# playwright devDependency's Chromium binary, so it cannot work in production.
BROWSER_DEBUG_LOCAL=false

# Daily pipeline run. All optional - the defaults are 21:00 Asia/Seoul, one
# article, and a minimum candidate score of 7 out of 10. The run draws from the
# candidates already scored and waiting rather than generating fresh ones, and
# tops that pool up only when it runs thin.
# The timezone matters: the container clock is UTC, so without it "21" would be
# six in the morning in Seoul.
PIPELINE_SCHEDULE_CRON=0 21 * * *
PIPELINE_SCHEDULE_TZ=Asia/Seoul
PIPELINE_MIN_SCORE=7
PIPELINE_DAILY_ARTICLES=1

# Server only. Binds the cloudflared container to the tunnel created in the
# Cloudflare dashboard, which is what puts Access in front of the site and lets
# the host keep every inbound port closed. Leave empty for local runs - compose
# will start cloudflared and it will simply fail to connect.
TUNNEL_TOKEN=

# Search Console sync. Both are optional: without them the app boots normally
# and the daily sync job completes having done nothing, saying so in its log.
# That is what lets the code deploy before the credentials exist.
#
# GSC_SITE_URL must match the property exactly - a URL-prefix property ends in
# a slash, a domain property looks like "sc-domain:example.com".
GSC_SITE_URL=
# The service account key, either raw JSON or base64 of it. Prefer base64: the
# raw file is one line of quotes and \n escapes, and dotenv, compose and the
# shell each get a turn at mangling those.
#   base64 -i service-account.json | tr -d '\n'
# The account also has to be added under Search Console > Settings > Users and
# permissions, or every call comes back 403.
GSC_SERVICE_ACCOUNT_JSON=
# 20:00, an hour ahead of the pipeline run, so the day's figures are already in
GSC_SYNC_CRON=0 20 * * *
GSC_SYNC_TZ=Asia/Seoul
GSC_LOOKBACK_DAYS=28
