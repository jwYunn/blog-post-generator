{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Pins the build output to dist/<path-under-src>. Without it TypeScript
    // infers the common root from whatever files are included, which nests
    // everything under dist/src as soon as a file outside src is compiled.
    "rootDir": "./src",
    // Must live inside outDir: nest-cli wipes outDir before each build, and a
    // build info file that survives that wipe makes the incremental compiler
    // skip emitting files it believes are already there, producing a partial dist.
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "scripts",
    "load.ts",
    "test.ts",
    "**/*spec.ts"
  ]
}
